<?xml version='1.0' encoding='utf-8'?>
<widget id="com.custom.batteryguard" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>BatteryGuard</name>
    <description>Приложение для контроля заряда батареи</description>
    <author email="dev@custom.com" href="http://custom.com">BatteryGuard Team</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    
    <preference name="android-minSdkVersion" value="23" />
    <preference name="android-targetSdkVersion" value="28" />

    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
</widget>